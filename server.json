{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pooriaarab/benchmark-skateboard",
  "description": "Score AI answers on skateboard trick rotations, projectile physics, landing orientation, and airtime feasibility.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/pooriaarab/benchmark-skateboard",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "benchmark-skateboard",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "subcommand",
          "value": "mcp"
        }
      ]
    }
  ]
}
